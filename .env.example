NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL
SUPABASE_SERVICE_ROLE_KEY=SUA_SERVICE_ROLE_KEY_APENAS_NO_SERVIDOR

# Tempo máximo da sessão autenticada, em minutos (padrão: 480 = 8 horas)
NEXT_PUBLIC_SESSION_EXPIRATION_MINUTES=480

# Cloudflare R2 - upload de fotos de produtos
R2_ACCOUNT_ID=SEU_ACCOUNT_ID
R2_ACCESS_KEY_ID=SUA_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=SUA_SECRET_ACCESS_KEY
R2_BUCKET=nome-do-bucket
R2_PUBLIC_URL=https://cdn.seudominio.com
